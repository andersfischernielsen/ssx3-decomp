# Rust
/target/
**/*.rs.bk

# Ghidra project (outside repo) / local scratch
*.gpr
*.rep/
*.lock
*.lock~

# OS
.DS_Store

# Large originals: keep the extracted ELF, ignore the disc image itself
*.iso

# Extracted, copyrighted game data (recreate with tools/extract-from-iso.sh)
/orig/

# Full sharded translation (reproduce with: recomp-all)
/generated/code/

# Agent worktrees and local Claude state (project skills are committed)
/.claude/*
!/.claude/skills/
# OpenCode delegate logs (scripts/delegate.sh)
/.delegate/
# Translated VU microcode and Ghidra disassembly listings: derived from the
# game's code, so not committed (tools/bootstrap.sh regenerates the VU code;
# tools/export-ghidra-disasm.py the listings, which only a recompiler test uses).
/generated/vu/
/generated/ghidra_disasm/
# Recompiled EE code (reproduce with: cargo run --release -p ssx3-recomp --bin recomp-ee)
/generated/ee/
# Its unwind form for the WebAssembly build (recomp-ee --unwind --out generated/ee-unwind --package-prefix ssx3-ee-unwind)
/generated/ee-unwind/
# Recompiled IOP modules (reproduce with: cargo run --release -p ssx3-recomp --bin recomp-iop)
/generated/iop/
# Memory card images written by the game (SSX3_MEMCARD)
/saves/
/target-prof
/target-unwind
/target-web
# Texture packs: dumped game textures and replacements (SSX3_TEX_DUMP, textures/replace)
/textures/
/crates/ssx3-web/www/pkg/
/crates/ssx3-web/www/pkg-vu/
