# Rust
/target/
**/*.rs.bk

# Ghidra project (outside repo) / local scratch
*.gpr
*.rep/
*.lock
*.lock~

# OS
.DS_Store

# Large originals: keep the extracted ELF, ignore the disc image itself
*.iso

# Extracted, copyrighted game data (recreate with tools/extract-from-iso.sh)
/orig/

# Full sharded translation (reproduce with: recomp-all)
/generated/code/

# Agent worktrees and local Claude state (project skills are committed)
/.claude/*
!/.claude/skills/
# OpenCode delegate logs (scripts/delegate.sh)
/.delegate/
# Recompiled EE code (reproduce with: cargo run --release -p ssx3-recomp --bin recomp-ee)
/generated/ee/
# Recompiled IOP modules (reproduce with: cargo run --release -p ssx3-recomp --bin recomp-iop)
/generated/iop/
# Memory card images written by the game (SSX3_MEMCARD)
/saves/
